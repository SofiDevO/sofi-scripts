#!/bin/bash
echo -e "\033[0;34m"
echo "╔════════════════════════════════════════════════════════╗"
echo "║              Set up development environment          ║"
echo "╚════════════════════════════════════════════════════════╝"
echo -e "\033[0m"

# Create .ssh folder if it does not exist
mkdir -p ~/.ssh

# Capture main user information
echo "🔧 Git user configuration:"
echo "📝 Enter the username for gitconfig:"
read main_user_name
echo "📧 Enter the email for gitconfig:"
read main_user_email
echo "Enter the SSH key name (will be used as gh-<name>, e.g. personal):"
read main_key_name
if [ -z "$main_key_name" ]; then
    echo "❌ SSH key name cannot be empty."
    exit 1
fi

# Arrays for additional users
declare -a extra_names
declare -a extra_emails
declare -a extra_dirs
extra_count=0

# Ask for additional users
while true; do
    echo ""
    echo "👥 Do you want to add an additional user to gitconfig?"
    select opt in "Yes, add another user" "No, continue"; do
        case $opt in
            "Yes, add another user")
                echo "📝 Enter the username:"
                read extra_name
                echo "📧 Enter the email:"
                read extra_email

                while true; do
                    echo "📁 Enter the directory name for this user (e.g. work):"
                    read dir_name
                    if [ -z "$dir_name" ]; then
                        echo "❌ Directory name cannot be empty."
                        continue
                    fi
                    if [ -d ~/"$dir_name" ]; then
                        echo "⚠️  Directory ~/$dir_name already exists."
                        select dir_opt in "Choose a different name" "Continue with this directory"; do
                            case $dir_opt in
                                "Choose a different name") break ;;
                                "Continue with this directory") break 2 ;;
                                *) echo "❌ Invalid option." ;;
                            esac
                        done
                        [[ "$dir_opt" == "Choose a different name" ]] && continue
                    fi
                    break
                done

                extra_names[$extra_count]="$extra_name"
                extra_emails[$extra_count]="$extra_email"
                extra_dirs[$extra_count]="$dir_name"
                extra_count=$((extra_count + 1))
                break
                ;;
            "No, continue")
                break 2
                ;;
            *) echo "❌ Invalid option." ;;
        esac
    done
done

echo ""
echo "📄 Generating Git configuration files..."

# Create main .gitconfig
cat > ~/.gitconfig << EOF
[user]
	name = $main_user_name
	email = $main_user_email

EOF

# Add includeIf for additional users
for ((i=0; i<extra_count; i++)); do
    cat >> ~/.gitconfig << EOF
[includeIf "gitdir:~/${extra_dirs[$i]}/"]
    path = ~/.gitconfig-${extra_dirs[$i]}

EOF
done

cat >> ~/.gitconfig << EOF
[init]
	defaultBranch = main
EOF

# Create .gitconfig for each additional user
for ((i=0; i<extra_count; i++)); do
    cat > ~/.gitconfig-${extra_dirs[$i]} << EOF
[user]
    name = ${extra_names[$i]}
    email = ${extra_emails[$i]}
EOF
    echo "✅ Created ~/.gitconfig-${extra_dirs[$i]}"
done

echo "🔐 Generating SSH configuration file..."

# Create SSH config file
cat > ~/.ssh/config << EOF
# Configuration for $main_user_name
Host gh-$main_key_name
    HostName github.com
    User git
    IdentityFile ~/.ssh/$main_key_name

EOF

# Add hosts for additional users
for ((i=0; i<extra_count; i++)); do
    cat >> ~/.ssh/config << EOF
# Configuration for ${extra_names[$i]} (${extra_dirs[$i]})
Host gh-${extra_dirs[$i]}
    HostName github.com
    User git
    IdentityFile ~/.ssh/${extra_dirs[$i]}

EOF
done

echo "🔐 Generating SSH key for $main_user_name..."

if [ ! -f ~/.ssh/"$main_key_name" ]; then
    echo "🔐 Set a password for the SSH key of $main_user_name"
    while true; do
        read -s -p "Password: " pass1
        echo
        read -s -p "Confirm password: " pass2
        echo
        if [ "$pass1" == "$pass2" ]; then
            ssh-keygen -t ed25519 -f ~/.ssh/"$main_key_name" -C "$main_user_email" -N "$pass1"
            break
        else
            echo "❌ Passwords do not match. Try again."
        fi
    done
else
    echo "ℹ️  Key ~/.ssh/$main_key_name already exists, skipping generation."
fi

# Generate SSH keys for additional users
for ((i=0; i<extra_count; i++)); do
    key="${extra_dirs[$i]}"
    if [ ! -f ~/.ssh/"$key" ]; then
        echo ""
        echo "🔐 Set a password for the SSH key of ${extra_names[$i]} ($key)"
        while true; do
            read -s -p "Password: " pass1
            echo
            read -s -p "Confirm password: " pass2
            echo
            if [ "$pass1" == "$pass2" ]; then
                ssh-keygen -t ed25519 -f ~/.ssh/"$key" -C "${extra_emails[$i]}" -N "$pass1"
                break
            else
                echo "❌ Passwords do not match. Try again."
            fi
        done
    else
        echo "ℹ️  Key ~/.ssh/$key already exists, skipping generation."
    fi
done

# Set correct permissions
chmod 700 ~/.ssh
chmod 600 ~/.ssh/config
[ -f ~/.ssh/"$main_key_name" ]     && chmod 600 ~/.ssh/"$main_key_name"
[ -f ~/.ssh/"$main_key_name".pub ] && chmod 644 ~/.ssh/"$main_key_name".pub
for ((i=0; i<extra_count; i++)); do
    key="${extra_dirs[$i]}"
    [ -f ~/.ssh/"$key" ]     && chmod 600 ~/.ssh/"$key"
    [ -f ~/.ssh/"$key".pub ] && chmod 644 ~/.ssh/"$key".pub
done

# Determine mainKey
if [ "$extra_count" -gt 0 ]; then
    echo ""
    echo "🔑 Which key should be the default (mainKey) for clone/push scripts?"
    echo "  0) $main_key_name (main user)"
    for ((i=0; i<extra_count; i++)); do
        echo "  $((i+1))) ${extra_dirs[$i]} (${extra_names[$i]})"
    done
    while true; do
        read -p "Answer [ENTER = $main_key_name]: " mainKey_choice
        if [ -z "$mainKey_choice" ]; then
            mainKey="$main_key_name"
            break
        fi
        if [[ "$mainKey_choice" =~ ^[0-9]+$ ]] && [ "$mainKey_choice" -ge 0 ] && [ "$mainKey_choice" -le "$extra_count" ]; then
            if [ "$mainKey_choice" -eq 0 ]; then
                mainKey="$main_key_name"
            else
                mainKey="${extra_dirs[$((mainKey_choice-1))]}"
            fi
            break
        fi
        echo "❌ Invalid option."
    done
else
    mainKey="$main_key_name"
fi

echo ""
echo "📄 Generating scripts in ~/.local/bin/..."

# Ensure ~/.local/bin exists
mkdir -p ~/.local/bin

# Generate clone-project
cat > ~/.local/bin/clone-project << 'SCRIPT_EOF'
#!/bin/bash
echo -e "\033[0;34m"
echo "╔════════════════════════════════════════════════════════╗"
echo "║   Clone repository from a specific branch 🦝           ║"
echo "╚════════════════════════════════════════════════════════╝"
echo -e "\033[0m"

# Default key
mainKey="__MAIKEY__"

# Find available SSH keys
mapfile -t ssh_keys < <(find ~/.ssh -maxdepth 1 -type f ! -name "*.pub" ! -name "config" ! -name "known_hosts" ! -name "authorized_keys" -printf "%f\n" 2>/dev/null)

if [ ${#ssh_keys[@]} -eq 0 ]; then
    echo "❌ No SSH keys found in ~/.ssh/"
    exit 1
fi

echo "🔑 Select the SSH key to use (ENTER = gh-$mainKey):"
for i in "${!ssh_keys[@]}"; do
    echo "  $((i+1))) gh-${ssh_keys[$i]}"
done

while true; do
    read -p "Answer: " key_choice
    if [ -z "$key_choice" ]; then
        key_name="$mainKey"
        break
    fi
    if [[ "$key_choice" =~ ^[0-9]+$ ]] && [ "$key_choice" -ge 1 ] && [ "$key_choice" -le "${#ssh_keys[@]}" ]; then
        key_name="${ssh_keys[$((key_choice-1))]}"
        break
    fi
    echo "❌ Invalid option."
done

DOMAIN="gh-$key_name"

# Enter branch name
echo "🦝 Enter the branch name you want to clone:"
read branch_name

if [ -z "$branch_name" ]; then
  echo "❌ Branch name cannot be empty."
  exit 1
fi

# Enter repository URL
echo "Enter the repository URL (e.g. git@github.com:user/repo.git):"
read repo_url

if [[ ! "$repo_url" =~ ^git@github\.com: ]]; then
  echo "❌ Invalid repository URL. It must start with git@github.com:"
  exit 1
fi

# Replace host with the appropriate domain
updated_url=$(echo "$repo_url" | sed "s|git@github\.com:|git@${DOMAIN}:|")

echo "🔗 Cloning from: $updated_url"
echo "🌱 Branch: $branch_name"

# Execute clone
git clone -b "$branch_name" --single-branch "$updated_url"

# Verify success
if [ $? -eq 0 ]; then
  echo "✅ Repository cloned successfully."
else
  echo "❌ Error cloning the repository."
fi
SCRIPT_EOF
sed -i "s|__MAIKEY__|${mainKey}|g" ~/.local/bin/clone-project
chmod +x ~/.local/bin/clone-project
echo "✅ Created ~/.local/bin/clone-project (mainKey=$mainKey)"

# Generate clone-repo
cat > ~/.local/bin/clone-repo << 'SCRIPT_EOF'
#!/bin/bash
echo -e "\033[0;34m"
echo "╔════════════════════════════════════════════════════════╗"
echo "║          Clone repository 🦝                           ║"
echo "╚════════════════════════════════════════════════════════╝"
echo -e "\033[0m"

# Default key
mainKey="__MAIKEY__"

# Find available SSH keys
mapfile -t ssh_keys < <(find ~/.ssh -maxdepth 1 -type f ! -name "*.pub" ! -name "config" ! -name "known_hosts" ! -name "authorized_keys" -printf "%f\n" 2>/dev/null)

if [ ${#ssh_keys[@]} -eq 0 ]; then
    echo "❌ No SSH keys found in ~/.ssh/"
    exit 1
fi

echo "🔑 Select the SSH key to use (ENTER = gh-$mainKey):"
for i in "${!ssh_keys[@]}"; do
    echo "  $((i+1))) gh-${ssh_keys[$i]}"
done

while true; do
    read -p "Answer: " key_choice
    if [ -z "$key_choice" ]; then
        key_name="$mainKey"
        break
    fi
    if [[ "$key_choice" =~ ^[0-9]+$ ]] && [ "$key_choice" -ge 1 ] && [ "$key_choice" -le "${#ssh_keys[@]}" ]; then
        key_name="${ssh_keys[$((key_choice-1))]}"
        break
    fi
    echo "❌ Invalid option."
done

ssh_host="gh-$key_name"

echo "Enter the repository URL (e.g. git@github.com:user/repo.git):"
read repo_url

if [[ ! "$repo_url" =~ ^git@github\.com: ]]; then
  echo "❌ URL format must start with git@github.com:"
  exit 1
fi

# Replace github.com with the SSH host
updated_url=$(echo "$repo_url" | sed "s/github.com/$ssh_host/")

# Load the SSH key into the agent
echo "🔑 Loading SSH key..."
ssh-add ~/.ssh/"$key_name"

echo "🔗 Cloning from: $updated_url"
git clone "$updated_url"

# Verification
if [ $? -eq 0 ]; then
  echo "✅ Repository cloned successfully."
else
  echo "❌ Error cloning the repository."
fi
SCRIPT_EOF
sed -i "s|__MAIKEY__|${mainKey}|g" ~/.local/bin/clone-repo
chmod +x ~/.local/bin/clone-repo
echo "✅ Created ~/.local/bin/clone-repo (mainKey=$mainKey)"

# Generate push-repo
cat > ~/.local/bin/push-repo << 'SCRIPT_EOF'
#!/bin/bash
echo -e "\033[0;34m"
echo "╔════════════════════════════════════════════════════════╗"
echo "║              Push to existing repository 🦝            ║"
echo "╚════════════════════════════════════════════════════════╝"
echo -e "\033[0m"

# Default key
mainKey="__MAIKEY__"

# Find available SSH keys
mapfile -t ssh_keys < <(find ~/.ssh -maxdepth 1 -type f ! -name "*.pub" ! -name "config" ! -name "known_hosts*" ! -name "authorized_keys" -printf "%f\n" 2>/dev/null)

if [ ${#ssh_keys[@]} -eq 0 ]; then
    echo "❌ No SSH keys found in ~/.ssh/"
    exit 1
fi

echo "🔑 Select the SSH key to use (ENTER = gh-$mainKey):"
for i in "${!ssh_keys[@]}"; do
    echo "  $((i+1))) gh-${ssh_keys[$i]}"
done

while true; do
    read -p "Answer: " key_choice
    if [ -z "$key_choice" ]; then
        key_name="$mainKey"
        break
    fi
    if [[ "$key_choice" =~ ^[0-9]+$ ]] && [ "$key_choice" -ge 1 ] && [ "$key_choice" -le "${#ssh_keys[@]}" ]; then
        key_name="${ssh_keys[$((key_choice-1))]}"
        break
    fi
    echo "❌ Invalid option."
done

SSH_KEY="gh-$key_name"

echo "📝 Enter the first commit message:"
read commit_message
if [ -z "$commit_message" ]; then
    echo "❌ Commit message cannot be empty."
    exit 1
fi

echo "🔗 Enter the repository URL (e.g. git@github.com:user/repo.git):"
read project_url

if [[ ! "$project_url" =~ ^git@github\.com: ]]; then
  echo "❌ Invalid repository URL. It must start with git@github.com:"
  exit 1
fi

# Replace github.com with the selected SSH host
updated_url=$(echo "$project_url" | sed "s/github.com/$SSH_KEY/")

echo "🔑 Loading SSH key..."
eval "$(ssh-agent -s)" > /dev/null 2>&1
ssh-add ~/.ssh/"$key_name"

echo "📦 Initializing Git repository..."
git init

echo "📁 Staging all files..."
git add .

echo "💾 Creating first commit..."
git commit -m "$commit_message"

echo "🌿 Switching to main branch..."
git branch -M main

echo "📤 Setting remote origin to: $updated_url"
git remote add origin "$updated_url"

echo "🔄 Pulling remote changes (README/LICENSE)..."
git pull origin main --allow-unrelated-histories --no-rebase --no-edit

echo "🚀 Pushing to repository..."
git push -u origin main

if [ $? -eq 0 ]; then
  echo "✅ Code pushed successfully to the repository."
else
  echo "❌ Error pushing to the repository."
  exit 1
fi
SCRIPT_EOF
sed -i "s|__MAIKEY__|${mainKey}|g" ~/.local/bin/push-repo
chmod +x ~/.local/bin/push-repo
echo "✅ Created ~/.local/bin/push-repo (mainKey=$mainKey)"

echo ""
echo "✅ Git and SSH configuration completed successfully."
echo "📋 Configuration summary:"
echo "   • Main user: $main_user_name ($main_user_email)"
for ((i=0; i<extra_count; i++)); do
    echo "   • Additional user: ${extra_names[$i]} (${extra_emails[$i]}) — ~/${extra_dirs[$i]}/"
done
echo "🔑 SSH keys:"
echo "   • ~/.ssh/$main_key_name (gh-$main_key_name) for $main_user_name"
for ((i=0; i<extra_count; i++)); do
    echo "   • ~/.ssh/${extra_dirs[$i]} for ${extra_names[$i]}"
done